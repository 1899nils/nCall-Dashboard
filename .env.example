# Copy to .env and adjust, or set these directly in docker-compose.yml.

TZ=Europe/Berlin

# Set to false once the real COMtrexx connection is verified (see README).
COMTREXX_MOCK=true
COMTREXX_BASE_URL=https://192.168.0.10
COMTREXX_USERNAME=
COMTREXX_PASSWORD=
COMTREXX_VERIFY_SSL=true
COMTREXX_CALL_ENDPOINT=/api/v1/callJournal

# Cron expression (5-field), evaluated in UTC.
SYNC_CRON=15 0 * * *
SYNC_LOOKBACK_DAYS=2

# JSON list seeding the extension-prefix -> Standort mapping on first start.
SITE_MAPPING_SEED=[]
